# Copy to .env and adjust. Everything has a working default - the project runs
# with zero configuration (SQLite + bundled model artefact).

# --- database ---------------------------------------------------------------
# Zero-setup default (created automatically):
#   DATABASE_URL=sqlite:///data/expenseiq.db
# Project target (MySQL 8, see mysql/schema.sql):
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/expenseiq

# --- auth -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- ml artefacts -----------------------------------------------------------
# MODEL_PATH=ml_models/xgboost_expense_forecaster_v2.pkl
# METRICS_PATH=ml_models/model_metrics.json

# --- forecasting rules ------------------------------------------------------
MIN_HISTORY_DAYS=30
FORECAST_WINDOW_DAYS=90
ANOMALY_SIGMA=3.0

# --- logging / frontend -----------------------------------------------------
LOG_LEVEL=INFO
# API_BASE_URL=http://localhost:8000
